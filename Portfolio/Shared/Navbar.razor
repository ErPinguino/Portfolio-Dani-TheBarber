@inject IJSRuntime JS

<!-- Barra de navegación fija con efecto glass premium -->
<nav id="navbar"
     class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/75 backdrop-blur-2xl border-b border-zinc-800/40
            transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

            <!-- ── LOGO ──────────────────────────────────────────────── -->
            <button @onclick='() => ScrollTo("home")'
                    class="font-display text-xl lg:text-2xl tracking-[0.18em] text-white
                           hover:text-amber-400 transition-colors duration-200 cursor-pointer">
                DANI THE BARBER
            </button>

            <!-- ── DESKTOP LINKS ──────────────────────────────────────── -->
            <div class="hidden md:flex items-center gap-1">
                @foreach (var link in _navLinks)
                {
                    <button @onclick="() => ScrollTo(link.SectionId)"
                            class="px-4 py-2 text-sm text-zinc-400 hover:text-white rounded-lg
                                   hover:bg-white/5 transition-all duration-200 cursor-pointer">
                        @link.Label
                    </button>
                }
                <!-- CTA principal -->
                <button @onclick='() => ScrollTo("contact")'
                        class="ml-3 px-5 py-2 text-sm font-bold bg-amber-400 text-neutral-950
                               rounded-lg hover:bg-amber-300 active:scale-95
                               transition-all duration-200 cursor-pointer">
                    CITA PREVIA
                </button>
            </div>

            <!-- ── HAMBURGER (mobile) ─────────────────────────────────── -->
            <button @onclick="ToggleMenu"
                    class="md:hidden p-2 text-zinc-400 hover:text-white transition-colors
                           rounded-lg hover:bg-white/5"
                    aria-label="Abrir menú de navegación"
                    aria-expanded="@_isOpen">
                <!-- Icono animado hamburguesa → X -->
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    @if (_isOpen)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    }
                </svg>
            </button>
        </div>

        <!-- ── MOBILE DROPDOWN ────────────────────────────────────────── -->
        @if (_isOpen)
        {
            <div class="md:hidden border-t border-zinc-800/50 py-3 space-y-1">
                @foreach (var link in _navLinks)
                {
                    <button @onclick="() => NavAndClose(link.SectionId)"
                            class="w-full text-left px-4 py-3 text-sm text-zinc-400 hover:text-white
                                   hover:bg-white/5 rounded-xl transition-all duration-200 cursor-pointer">
                        @link.Label
                    </button>
                }
                <button @onclick='() => NavAndClose("contact")'
                        class="w-full mt-2 px-5 py-3 text-sm font-bold text-center
                               bg-amber-400 text-neutral-950 rounded-xl hover:bg-amber-300
                               transition-colors duration-200 cursor-pointer">
                    CITA PREVIA
                </button>
            </div>
        }
    </div>
</nav>

@code {
    private bool _isOpen;

    private record NavLink(string Label, string SectionId);

    private static readonly NavLink[] _navLinks =
    [
        new("Inicio",    "home"),
        new("Sobre mí",  "about"),
        new("Servicios", "services"),
        new("Portfolio", "portfolio"),
        new("Contacto",  "contact")
    ];

    private void ToggleMenu() => _isOpen = !_isOpen;

    /// <summary>
    /// Navega con smooth scroll a la sección indicada.
    /// Requiere window.scrollToSection(id) definido en wwwroot/index.html.
    /// </summary>
    private async Task ScrollTo(string sectionId) =>
        await JS.InvokeVoidAsync("scrollToSection", sectionId);

    /// <summary>Cierra el menú móvil y navega a la sección.</summary>
    private async Task NavAndClose(string sectionId)
    {
        _isOpen = false;
        await ScrollTo(sectionId);
    }
}
