<section id="services" class="relative py-24 lg:py-36 bg-neutral-950 overflow-hidden">

    <div class="absolute inset-0 pointer-events-none opacity-40"
         style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.04) 1px, transparent 0);
                background-size: 40px 40px;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ENCABEZADO -->
        <div class="flex items-end gap-4 mb-16 lg:mb-20">
            <span class="font-display text-[7rem] lg:text-[9rem] leading-none text-zinc-800/50 select-none"
                  aria-hidden="true">02</span>
            <div class="pb-2">
                <p class="text-amber-400 text-xs tracking-[0.3em] uppercase font-semibold mb-1">Lo que hago</p>
                <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-none">SERVICIOS</h2>
            </div>
        </div>

        <!-- GRID DE TARJETAS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var service in _services)
            {
                <div class="group relative bg-zinc-900 border border-zinc-800/80 rounded-2xl p-7
                            hover:border-amber-400/40 transition-all duration-300 overflow-hidden cursor-default">

                    <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100
                                transition-opacity duration-300 pointer-events-none"
                         style="background: radial-gradient(ellipse at top left, rgba(251,191,36,0.06), transparent 60%);"></div>

                    <div class="absolute top-4 right-5 font-display text-6xl text-zinc-800/40
                                select-none leading-none group-hover:text-zinc-700/40 transition-colors duration-300"
                         aria-hidden="true">@service.Index</div>

                    <div class="relative z-10">

                        <!-- Icono: @if/@else if evita la ambigüedad del @switch con break; en Razor -->
                        <div class="w-12 h-12 rounded-xl bg-zinc-800/80 border border-zinc-700/60
                                    flex items-center justify-center mb-6
                                    group-hover:border-amber-400/30 group-hover:bg-amber-400/5
                                    transition-all duration-300">
                            @if (service.Index == "01")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <circle cx="6" cy="6" r="3" />
                                    <circle cx="6" cy="18" r="3" />
                                    <line x1="20" y1="4" x2="8.12" y2="15.88" />
                                    <line x1="14.47" y1="14.48" x2="20" y2="20" />
                                    <line x1="8.12" y1="8.12" x2="12" y2="12" />
                                </svg>
                            }
                            else if (service.Index == "02")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                                </svg>
                            }
                            else if (service.Index == "03")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
                                </svg>
                            }
                            else if (service.Index == "04")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M5.25 7.5A2.25 2.25 0 017.5 5.25h9a2.25 2.25 0 012.25 2.25v9a2.25 2.25 0 01-2.25 2.25h-9a2.25 2.25 0 01-2.25-2.25v-9z" />
                                </svg>
                            }
                            else if (service.Index == "05")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008z" />
                                </svg>
                            }
                        </div>

                        <h3 class="text-xl font-bold text-white mb-2 leading-tight">@service.Title</h3>
                        <p class="text-zinc-500 text-sm leading-relaxed mb-5">@service.Description</p>

                        <div class="h-px bg-zinc-800 mb-5 group-hover:bg-amber-400/20 transition-colors duration-300"></div>

                        <div class="flex items-center justify-between">
                            <span class="text-amber-400 font-bold text-lg">@service.Price</span>
                            <span class="text-zinc-600 text-xs tracking-widest uppercase">@service.Duration</span>
                        </div>

                    </div>
                </div>
            }
        </div>

        <p class="text-center text-zinc-700 text-sm mt-12 tracking-wide">
            ¿Tienes algo en mente que no está aquí?
            <a href="#contact" class="text-amber-400 hover:text-amber-300 transition-colors ml-1">Cuéntamelo →</a>
        </p>
    </div>
</section>

@code {
    private record ServiceItem(string Index, string Title, string Description, string Price, string Duration);

    private static readonly ServiceItem[] _services =
    [
        new("01", "Degradado / Fade",
            "Degradado medio, alto o bajo con transición perfecta entre máquinas. Acabado a navaja.",
            "desde 12€", "45 min"),
        new("02", "Perfilado de Barba",
            "Definición completa de líneas, igualado de largos y acabado con aceite nutritivo premium.",
            "desde 8€", "30 min"),
        new("03", "Corte Clásico",
            "Corte completo con tijera y máquina. Lavado, secado y styling incluido.",
            "desde 15€", "60 min"),
        new("04", "Diseño Geométrico",
            "Grabado artístico a navaja: líneas, figuras y patrones personalizados. Arte puro.",
            "desde 18€", "75 min"),
        new("05", "Buzz Cut",
            "Rapado uniforme al número elegido. Simple, limpio y con un resultado impecable.",
            "desde 10€", "20 min"),
        new("06", "Colorimetría",
            "Mechas, degradados de color y tratamientos capilares adaptados a tu tono natural.",
            "desde 25€", "90 min")
    ];
}
