@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<!-- ═══════════════════════════════════════════════════════════
     CONTACT FORM — Formulario de contacto
     Envía datos a la Azure Function POST /api/contact.
     Estados UI: Idle | Sending | Success | Error.
     NOTA LOCAL: en desarrollo, asegúrate de que la Azure Function
     esté corriendo en puerto 7071. En ASWA producción, /api/*
     se sirve desde el mismo dominio (sin problemas de CORS).
════════════════════════════════════════════════════════════ -->
<section id="contact" class="relative py-24 lg:py-36 bg-neutral-950 overflow-hidden">

    <!-- Halo ámbar centrado -->
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse at center bottom, rgba(251,191,36,0.05), transparent 60%);">
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ── ENCABEZADO ─────────────────────────────────────────── -->
        <div class="flex items-end gap-4 mb-14 lg:mb-20">
            <span class="font-display text-[7rem] lg:text-[9rem] leading-none text-zinc-800/50
                         select-none" aria-hidden="true">04</span>
            <div class="pb-2">
                <p class="text-amber-400 text-xs tracking-[0.3em] uppercase font-semibold mb-1">
                    Hablemos
                </p>
                <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-none">
                    CONTACTO
                </h2>
            </div>
        </div>

        <!-- ── LAYOUT 2 COLUMNAS ─────────────────────────────────── -->
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-start">

            <!-- Columna izquierda: info de contacto (2/5) -->
            <aside class="lg:col-span-2 space-y-8">

                <p class="text-zinc-400 text-[1.025rem] leading-relaxed">
                    ¿Tienes algo en mente? Cuéntame qué quieres para tu próxima cita.
                    Respondo en menos de 24 horas.
                </p>

                <!-- Info de contacto -->
                <div class="space-y-5">
                    @foreach (var item in _contactInfo)
                    {
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800
                                        flex items-center justify-center flex-shrink-0">
                                @((MarkupString)item.IconSvg)
                            </div>
                            <div>
                                <p class="text-zinc-600 text-xs tracking-[0.2em] uppercase mb-0.5">
                                    @item.Label
                                </p>
                                <p class="text-zinc-300 text-sm">@item.Value</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Horario compacto -->
                <div class="rounded-xl bg-zinc-900 border border-zinc-800 p-5">
                    <p class="text-xs tracking-[0.25em] uppercase text-zinc-600 mb-4 font-semibold">
                        Horario
                    </p>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-zinc-500">Lun – Vie</span>
                            <span class="text-white font-medium">9:00 – 20:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-zinc-500">Sábado</span>
                            <span class="text-white font-medium">9:00 – 14:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-zinc-500">Domingo</span>
                            <span class="text-zinc-700">Cerrado</span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Columna derecha: formulario (3/5) -->
            <div class="lg:col-span-3">

                <!-- ══════════════════════════════════════════════
                     ESTADO: ÉXITO
                ═══════════════════════════════════════════════ -->
                @if (_state == FormState.Success)
                {
                    <div class="rounded-2xl bg-zinc-900 border border-zinc-800 p-10
                                flex flex-col items-center justify-center text-center gap-5
                                min-h-[420px]">
                        <div class="w-16 h-16 rounded-full bg-amber-400/10 border border-amber-400/30
                                    flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-400"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-white text-xl font-bold mb-2">¡Mensaje enviado!</h3>
                            <p class="text-zinc-400 text-sm leading-relaxed max-w-sm">
                                @_successMessage
                            </p>
                        </div>
                        <button @onclick="ResetForm"
                                class="mt-2 px-6 py-2.5 text-sm font-medium text-zinc-400
                                       border border-zinc-800 rounded-full hover:border-zinc-600
                                       hover:text-white transition-all duration-200">
                            Enviar otro mensaje
                        </button>
                    </div>
                }
                else
                {
                    <!-- ══════════════════════════════════════════
                         FORMULARIO (Idle + Sending + Error)
                    ═══════════════════════════════════════════ -->
                    <div class="rounded-2xl bg-zinc-900 border border-zinc-800 p-8 space-y-6">

                        <!-- Campo: Nombre -->
                        <div class="space-y-2">
                            <label class="text-xs tracking-[0.25em] uppercase text-zinc-500 font-semibold block">
                                Nombre
                            </label>
                            <input @bind="_model.Name"
                                   @bind:event="oninput"
                                   placeholder="Tu nombre completo"
                                   disabled="@(_state == FormState.Sending)"
                                   class="w-full bg-zinc-800/60 border rounded-xl px-4 py-3.5
                                          text-white text-sm placeholder:text-zinc-700
                                          focus:outline-none transition-colors duration-200
                                          disabled:opacity-50 disabled:cursor-not-allowed
                                          @GetInputBorderClass("Name")" />
                            @if (_fieldErrors.TryGetValue("Name", out var nameErr))
                            {
                                <p class="text-red-400 text-xs mt-1">@nameErr</p>
                            }
                        </div>

                        <!-- Campo: Email -->
                        <div class="space-y-2">
                            <label class="text-xs tracking-[0.25em] uppercase text-zinc-500 font-semibold block">
                                Email
                            </label>
                            <input @bind="_model.Email"
                                   @bind:event="oninput"
                                   type="email"
                                   placeholder="tu@email.com"
                                   disabled="@(_state == FormState.Sending)"
                                   class="w-full bg-zinc-800/60 border rounded-xl px-4 py-3.5
                                          text-white text-sm placeholder:text-zinc-700
                                          focus:outline-none transition-colors duration-200
                                          disabled:opacity-50 disabled:cursor-not-allowed
                                          @GetInputBorderClass("Email")" />
                            @if (_fieldErrors.TryGetValue("Email", out var emailErr))
                            {
                                <p class="text-red-400 text-xs mt-1">@emailErr</p>
                            }
                        </div>

                        <!-- Campo: Mensaje -->
                        <div class="space-y-2">
                            <label class="text-xs tracking-[0.25em] uppercase text-zinc-500 font-semibold block">
                                Mensaje
                            </label>
                            <textarea @bind="_model.Message"
                                      @bind:event="oninput"
                                      rows="5"
                                      placeholder="Cuéntame qué tipo de corte quieres, fecha preferida…"
                                      disabled="@(_state == FormState.Sending)"
                                      class="w-full bg-zinc-800/60 border rounded-xl px-4 py-3.5
                                             text-white text-sm placeholder:text-zinc-700
                                             focus:outline-none transition-colors duration-200
                                             resize-none disabled:opacity-50 disabled:cursor-not-allowed
                                             @GetInputBorderClass("Message")">
                            </textarea>
                            @if (_fieldErrors.TryGetValue("Message", out var msgErr))
                            {
                                <p class="text-red-400 text-xs mt-1">@msgErr</p>
                            }
                        </div>

                        <!-- Error global -->
                        @if (_state == FormState.Error && !string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="rounded-xl bg-red-500/10 border border-red-500/30 px-4 py-3
                                        flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-400 flex-shrink-0"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948
                                             3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949
                                             3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75h.007v.008H12v-.008z" />
                                </svg>
                                <p class="text-red-400 text-sm">@_errorMessage</p>
                            </div>
                        }

                        <!-- Botón de envío -->
                        <button @onclick="SubmitAsync"
                                disabled="@(_state == FormState.Sending)"
                                class="w-full py-4 font-bold text-sm tracking-widest uppercase
                                       rounded-xl transition-all duration-300 active:scale-[0.98]
                                       @GetSubmitClass()">
                            @if (_state == FormState.Sending)
                            {
                                <!-- Spinner -->
                                <span class="inline-flex items-center gap-3">
                                    <svg class="w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg"
                                         fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10"
                                                stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor"
                                              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                    </svg>
                                    ENVIANDO…
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-2">
                                    ENVIAR MENSAJE
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4"
                                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12
                                                 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                                    </svg>
                                </span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    // ── ESTADOS DE LA UI ──────────────────────────────────────────────
    private enum FormState { Idle, Sending, Success, Error }
    private FormState _state = FormState.Idle;

    // ── MODELO DEL FORMULARIO ─────────────────────────────────────────
    private ContactFormModel _model = new();
    private string? _successMessage;
    private string? _errorMessage;

    // Errores por campo devueltos por la Azure Function (DataAnnotations)
    private Dictionary<string, string> _fieldErrors = [];

    // ── DTO de respuesta de la Azure Function ─────────────────────────
    private sealed class ApiResponse
    {
        public bool              Success  { get; init; }
        public string?           Message  { get; init; }
        public string?           Error    { get; init; }
        // Para errores de validación por campo: { "Name": ["msg1"], "Email": ["msg2"] }
        public Dictionary<string, string[]>? Errors { get; init; }
    }

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    // ── ENVÍO DEL FORMULARIO ──────────────────────────────────────────
    private async Task SubmitAsync()
    {
        if (!ValidateClientSide()) return;

        _state        = FormState.Sending;
        _errorMessage = null;
        _fieldErrors  = [];

        try
        {
            // En ASWA el path relativo /api/contact funciona sin CORS.
            // En desarrollo local, asegúrate de usar Azure SWA CLI o configura
            // el BaseAddress de HttpClient al puerto 7071 de la Azure Function.
            var response = await Http.PostAsJsonAsync("api/contact", new
            {
                _model.Name,
                _model.Email,
                _model.Message
            });

            var body = await response.Content.ReadFromJsonAsync<ApiResponse>(JsonOpts);

            if (response.IsSuccessStatusCode && body?.Success == true)
            {
                _state          = FormState.Success;
                _successMessage = body.Message ?? "Tu mensaje ha sido enviado. ¡Te respondo pronto!";
            }
            else
            {
                _state = FormState.Error;

                // Mapear errores de validación por campo si los hay
                if (body?.Errors is { Count: > 0 })
                {
                    _fieldErrors = body.Errors.ToDictionary(
                        kvp => kvp.Key,
                        kvp => string.Join(". ", kvp.Value));
                    _errorMessage = "Por favor, corrige los errores del formulario.";
                }
                else
                {
                    _errorMessage = body?.Error
                        ?? "No se pudo enviar el mensaje. Inténtalo de nuevo más tarde.";
                }
            }
        }
        catch (HttpRequestException)
        {
            _state        = FormState.Error;
            _errorMessage = "Error de conexión. Comprueba tu red e inténtalo de nuevo.";
        }
        catch (Exception)
        {
            _state        = FormState.Error;
            _errorMessage = "Ocurrió un error inesperado. Por favor, inténtalo de nuevo.";
        }
    }

    /// <summary>Validación ligera en cliente antes de hacer la petición HTTP.</summary>
    private bool ValidateClientSide()
    {
        _fieldErrors = [];

        if (string.IsNullOrWhiteSpace(_model.Name))
            _fieldErrors["Name"] = "El nombre es obligatorio.";

        if (string.IsNullOrWhiteSpace(_model.Email))
            _fieldErrors["Email"] = "El email es obligatorio.";
        else if (!_model.Email.Contains('@'))
            _fieldErrors["Email"] = "El formato del email no es válido.";

        if (string.IsNullOrWhiteSpace(_model.Message))
            _fieldErrors["Message"] = "El mensaje es obligatorio.";
        else if (_model.Message.Length < 10)
            _fieldErrors["Message"] = "El mensaje debe tener al menos 10 caracteres.";

        return _fieldErrors.Count == 0;
    }

    private void ResetForm()
    {
        _model        = new ContactFormModel();
        _state        = FormState.Idle;
        _errorMessage = null;
        _successMessage = null;
        _fieldErrors  = [];
    }

    private string GetInputBorderClass(string field) =>
        _fieldErrors.ContainsKey(field)
            ? "border-red-500/60 focus:border-red-500"
            : "border-zinc-700/60 focus:border-amber-400/60";

    private string GetSubmitClass() =>
        _state == FormState.Sending
            ? "bg-zinc-700 text-zinc-400 cursor-not-allowed"
            : "bg-amber-400 text-neutral-950 hover:bg-amber-300 hover:shadow-[0_0_30px_rgba(251,191,36,0.2)]";

    // ── DATOS ESTÁTICOS ───────────────────────────────────────────────
    private sealed class ContactFormModel
    {
        public string Name    { get; set; } = string.Empty;
        public string Email   { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }

    private record ContactInfoItem(string Label, string Value, string IconSvg);

    private static readonly ContactInfoItem[] _contactInfo =
    [
        new("Teléfono / WhatsApp", "+34 600 000 000",
            """<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>"""),
        new("Ubicación", "Elche, Alicante",
            """<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>"""),
        new("Instagram", "@danithebarbershop",
            """<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>""")
    ];
}
