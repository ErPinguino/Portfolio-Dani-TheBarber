@using BarberPortfolio.Models

<!-- ═══════════════════════════════════════════════════════════
     GALLERY CARD — Tarjeta individual de corte
     - Muestra la foto "después" por defecto.
     - Si BeforeImageUrl != null: crossfade al hover (desktop)
       o toggle con botón (mobile).
     - Badge de categoría, título y overlay gradiente inferior.
════════════════════════════════════════════════════════════ -->
<article class="group relative bg-zinc-900 rounded-2xl overflow-hidden
                border border-zinc-800/80 hover:border-zinc-700
                transition-all duration-300 hover:shadow-[0_20px_50px_rgba(0,0,0,0.5)]
                cursor-pointer"
         @onmouseenter="OnMouseEnter"
         @onmouseleave="OnMouseLeave">

    <!-- ── CONTENEDOR DE IMÁGENES ────────────────────────────── -->
    <div class="relative aspect-[3/4] overflow-hidden bg-zinc-800">

        <!-- Imagen DESPUÉS (siempre presente, fade out on hover si hay "antes") -->
        <img src="@Haircut.ImageUrl"
             alt="@Haircut.Title"
             loading="lazy"
             class="absolute inset-0 w-full h-full object-cover object-center
                    transition-opacity duration-500 ease-in-out
                    @(_showBefore ? "opacity-0" : "opacity-100")" />

        <!-- Imagen ANTES (solo si disponible, fade in on hover) -->
        @if (Haircut.BeforeImageUrl is not null)
        {
            <img src="@Haircut.BeforeImageUrl"
                 alt="Antes — @Haircut.Title"
                 loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover object-center
                        transition-opacity duration-500 ease-in-out
                        @(_showBefore ? "opacity-100" : "opacity-0")" />

            <!-- Etiqueta flotante ANTES / DESPUÉS -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
                        opacity-0 group-hover:opacity-100 transition-opacity duration-300
                        pointer-events-none flex items-center gap-2">
                <span class="text-[10px] font-bold tracking-[0.3em] uppercase
                             @(_showBefore ? "text-white" : "text-zinc-500")">
                    ANTES
                </span>
                <div class="w-px h-4 bg-white/40"></div>
                <span class="text-[10px] font-bold tracking-[0.3em] uppercase
                             @(!_showBefore ? "text-white" : "text-zinc-500")">
                    DESPUÉS
                </span>
            </div>
        }

        <!-- Overlay gradiente inferior para legibilidad del texto -->
        <div class="absolute bottom-0 left-0 right-0 h-2/3 pointer-events-none
                    bg-gradient-to-t from-neutral-950/95 via-neutral-950/40 to-transparent">
        </div>

        <!-- ── BADGE CATEGORÍA (arriba-izquierda) ───────────── -->
        <div class="absolute top-3 left-3 z-10">
            <span class="px-2.5 py-1 text-[10px] font-bold tracking-[0.25em] uppercase
                         rounded-full bg-black/60 backdrop-blur-sm border border-zinc-700/60
                         text-zinc-400">
                @Haircut.Category
            </span>
        </div>

        <!-- ── BOTÓN ANTES/DESPUÉS MOBILE (arriba-derecha) ──── -->
        @if (Haircut.BeforeImageUrl is not null)
        {
            <button @onclick:stopPropagation="true"
                    @onclick="ToggleMobile"
                    class="absolute top-3 right-3 z-10 md:hidden
                           px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase
                           rounded-full bg-black/70 backdrop-blur-sm border border-zinc-700/60
                           transition-colors duration-200
                           @(_showBefore
                               ? "text-amber-400 border-amber-400/40"
                               : "text-zinc-400 border-zinc-700/60")"
                    aria-label="Ver antes/después">
                @(_showBefore ? "DESPUÉS ↺" : "ANTES →")
            </button>
        }

        <!-- ── INFO INFERIOR ─────────────────────────────────── -->
        <div class="absolute bottom-0 left-0 right-0 p-4 z-10">

            <!-- Fecha de creación -->
            <time class="text-zinc-600 text-[10px] tracking-[0.2em] uppercase block mb-1">
                @Haircut.DateCreated.ToString("MMM yyyy")
            </time>

            <!-- Título -->
            <h3 class="text-white font-bold text-base leading-tight
                       group-hover:text-amber-400 transition-colors duration-200">
                @Haircut.Title
            </h3>

            <!-- Descripción corta (visible solo en hover) -->
            @if (!string.IsNullOrEmpty(Haircut.Description))
            {
                <p class="text-zinc-500 text-xs mt-1 leading-relaxed line-clamp-2
                          max-h-0 overflow-hidden group-hover:max-h-10
                          transition-all duration-300 ease-out">
                    @Haircut.Description
                </p>
            }
        </div>

        <!-- Indicador de "tiene antes" (punto ámbar esquina) -->
        @if (Haircut.BeforeImageUrl is not null)
        {
            <div class="absolute bottom-3 right-3 z-10 hidden md:block">
                <div class="w-2 h-2 rounded-full bg-amber-400
                            group-hover:animate-ping opacity-75"></div>
            </div>
        }
    </div>
</article>

@code {
    /// <summary>Corte de cabello a mostrar. Obligatorio.</summary>
    [Parameter, EditorRequired]
    public Haircut Haircut { get; set; } = null!;

    private bool _showBefore;

    // En desktop: el hover controla el estado via mouse events.
    // OnMouseEnter activa "antes" solo si tiene beforeImage.
    private void OnMouseEnter() => _showBefore = Haircut.BeforeImageUrl is not null;
    private void OnMouseLeave() => _showBefore = false;

    // En mobile: el botón hace toggle explícito.
    private void ToggleMobile() => _showBefore = !_showBefore;
}
